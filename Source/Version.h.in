#pragma once

#include <string>

// Generated at build time from cmake/GitVersion.cmake — do not edit the copy in
// the build tree. The template lives at Source/Version.h.in.
namespace rudder
{
inline constexpr auto appVersion = "@RUDDER_PROJECT_VERSION@";
inline constexpr auto gitSha = "@RUDDER_GIT_SHA@";
inline constexpr bool gitDirty = @RUDDER_GIT_DIRTY@ != 0;

// Short label for the title bar / logs, e.g. "e5c6236" or "e5c6236*" (dirty).
inline std::string versionTag()
{
    return std::string {gitSha} + (gitDirty ? "*" : "");
}
} // namespace rudder
